# Public, non-secret build settings. Never put API keys in this file:
# every VITE_ variable is embedded in the public JavaScript bundle.

# Absolute URL of the deployed site, used for social-sharing metadata.
VITE_SITE_URL=https://jovingj24jan-png.github.io/thinkbig-website

# Base path used by local builds. The GitHub Actions workflow overrides it
# with /<repository-name>/ so you rarely need to change this.
VITE_BASE_PATH=/
